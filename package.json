{
  "name": "syno-pkg-land-mailplus-setup-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:local": "node --test tests/local/*.test.mjs",
    "test:nas:ctl": "node --env-file-if-exists=.env --test tests/ctl/*.test.mjs",
    "e2e:smoke": "node --env-file-if-exists=.env node_modules/@synopackageland/cli/dist/e2e/dsm.js tunnel -- e2e run tests/e2e/smoke.e2e.ts",
    "e2e:ui": "node --env-file-if-exists=.env node_modules/@synopackageland/cli/dist/e2e/dsm.js tunnel -- e2e run tests/e2e/action.e2e.ts",
    "e2e:ai": "node --env-file-if-exists=.env node_modules/@synopackageland/cli/dist/e2e/dsm.js tunnel -- e2e run --config e2e.ai.config.ts tests/e2e/action.ai.e2e.ts",
    "test:go": "sh scripts/go-test.sh"
  },
  "devDependencies": {
    "@synopackageland/cli": "~0.54.15",
    "@e2e-dev/web": "^0.14.0",
    "e2e": "^0.19.0"
  },
  "license": "Apache-2.0"
}
